# 이 프로젝트에서 사용하는 환경변수 목록입니다.
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우고 개발 서버를 재시작하세요.
#
#   cp .env.example .env.local
#
# 주의: NEXT_PUBLIC_ 접두사를 붙이면 API 키가 브라우저 번들에 노출됩니다. 붙이지 마세요.

# OpenAI API 키 (필수) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 사용할 모델 (선택). 미설정 시 gpt-5.6-terra 를 사용합니다.
# Structured Outputs(json_schema) 를 지원하는 모델이어야 합니다.
#
# gpt-5 계열·o 시리즈는 추론 모델이라 temperature 를 지원하지 않고 reasoning_effort 를 받습니다.
# 코드가 모델명을 보고 자동으로 분기하므로(src/lib/openai-model.ts)
# gpt-4.1-mini 같은 구모델을 지정해도 그대로 동작합니다.
OPENAI_MODEL=gpt-5.6-terra

# 광고 소재 기획(/creative-brief) 전용 모델 (선택).
# 크리에이티브 카피라이팅·아이디어 발상 품질이 더 좋은 모델을 따로 쓰고 싶을 때 지정합니다.
# 미설정 시 OPENAI_MODEL 을 쓰고, 그것도 없으면 gpt-5.6-terra 를 사용합니다.
# 소재 기획은 추론 강도를 medium 으로(광고 문구는 low) 올려 호출합니다.
# OPENAI_CREATIVE_MODEL=


# ─────────────────────────────────────────────────────────────
# 유튜브 모니터링 (/youtube-monitoring)
# ─────────────────────────────────────────────────────────────

# YouTube Data API v3 키 (필수)
# https://console.cloud.google.com → 라이브러리에서 "YouTube Data API v3" 사용 설정 → 사용자 인증 정보에서 API 키 발급
#
# [할당량 주의] search.list 호출 1회가 100 유닛을 소모합니다. 기본 할당량은 하루 10,000 유닛이므로
# 페이지 수를 늘릴수록 하루 검색 가능 횟수가 급격히 줄어듭니다.
# (YOUTUBE_SEARCH_PAGES=2 기준 검색 1회 ≈ 200 유닛 → 하루 약 50회)
YOUTUBE_API_KEY=

# 검색 시 조회할 페이지 수 (선택, 1~6, 기본 2). 페이지당 영상 50개.
# 값을 올리면 한 번에 더 많은 영상을 보지만 할당량을 그만큼 더 씁니다.
# YOUTUBE_SEARCH_PAGES=2


# ─────────────────────────────────────────────────────────────
# 인스타 댓글 수집 (/instagram-comments)
# ─────────────────────────────────────────────────────────────

# 인스타그램 로그인 세션 쿠키 (JSON 배열, 필수)
# 형식: [{"name":"sessionid","value":"...","domain":".instagram.com","path":"/"}, ...]
#
# [보안 경고] sessionid 는 계정 탈취에 그대로 쓸 수 있는 비밀값입니다.
#   - NEXT_PUBLIC_ 접두사 금지 (브라우저 번들에 노출됩니다)
#   - 저장소에 커밋 금지 (.env*.local 은 .gitignore 대상입니다)
#   - 수 일~수 주 안에 만료되며, 만료 시 화면에 세션 만료 안내가 표시됩니다
#   - 자동 수집은 인스타그램 이용약관 제한 대상이므로 본인 계정/게시물 범위에서만 사용하세요
INSTAGRAM_COOKIES=


# ─────────────────────────────────────────────────────────────
# 크롤링 공통 (네이버 블로그 댓글 수집 · 인스타 댓글 수집)
# ─────────────────────────────────────────────────────────────

# 로컬 개발용 Chrome/Chromium 실행 파일 경로 (선택)
# 미설정 시 운영체제별 표준 설치 경로를 자동 탐색하고, 찾지 못하면 명확한 오류를 던집니다.
# 프로덕션(NODE_ENV=production)에서는 @sparticuz/chromium 을 쓰므로 이 값이 필요 없습니다.
#
# WSL/Linux: CHROME_PATH=/usr/bin/google-chrome
# Windows:   CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS:     CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=
