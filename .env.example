# 광고 문구 생성(/ad-copy)에 필요한 환경변수입니다.
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우고 개발 서버를 재시작하세요.
#
#   cp .env.example .env.local
#
# 주의: NEXT_PUBLIC_ 접두사를 붙이면 API 키가 브라우저 번들에 노출됩니다. 붙이지 마세요.

# OpenAI API 키 (필수) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 사용할 모델 (선택). 미설정 시 gpt-5.6-terra 를 사용합니다.
# Structured Outputs(json_schema) 를 지원하는 모델이어야 합니다.
#
# gpt-5 계열·o 시리즈는 추론 모델이라 temperature 를 지원하지 않고 reasoning_effort 를 받습니다.
# 코드가 모델명을 보고 자동으로 분기하므로(src/lib/openai-model.ts)
# gpt-4.1-mini 같은 구모델을 지정해도 그대로 동작합니다.
OPENAI_MODEL=gpt-5.6-terra
